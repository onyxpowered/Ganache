{
  "rules": {
    ".read": false,
    ".write": false,
    "S": {
      "$Id": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "$Id.length >= 20",
        "$Kind": {
          "$Slot": {
            ".validate": "newData.hasChildren(['Seq', 'Data']) && newData.child('Seq').isNumber() && newData.child('Data').isString() && newData.child('Data').val().length < 900000"
          }
        }
      }
    }
  }
}
